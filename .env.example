# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only, never expose to the browser (needed to invite brand-new team members)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the site. It is put inside invitation emails, so in production it MUST be set
# (e.g. https://your-project.vercel.app, or your own domain later). Also add it in Supabase:
# Authentication -> URL Configuration -> Site URL and Redirect URLs (https://your-project.vercel.app/**).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
