# Copy to .env.local (local) and set the same names in Vercel -> Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Platform administrator(s): comma-separated Supabase user UIDs. These accounts are NEVER asked to pay, see the
# admin-dashboard button, and the companies they own are open for their whole team (demos / testing).
SUPER_ADMIN_USER_IDS=
# optional alternative (confirmed emails only): SUPER_ADMIN_EMAILS=you@example.com

# XPay
XPAY_SECRET_KEY=
XPAY_WEBHOOK_SECRET=
BILLING_PRICES_CONFIRMED=false
