# ─────────────────────────────────────────────────────────────────────────────────────────────
# Kayan — environment variables.  Copy to .env.local for development; set the same names in
# Vercel → Project → Settings → Environment Variables for production.  NEVER commit real values.
# Legend:  [REQUIRED] app does not work without it   [PROD] required for production
#          [OPTIONAL] has a safe default / feature is off without it
# Anything starting with NEXT_PUBLIC_ is visible in the browser — never put a secret there.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────────────────────
# [REQUIRED] Project URL and the public (anon) key — Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# [REQUIRED] SERVER ONLY (never NEXT_PUBLIC_). Used for invitations, the admin dashboard, payment webhooks, email log, health check.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Site address ─────────────────────────────────────────────────────────────────────────────
# [PROD] Public https address, no trailing slash. Used inside e-mail links, payment return URLs, sitemap and Open Graph.
# Must equal Supabase → Authentication → URL Configuration → Site URL.
NEXT_PUBLIC_SITE_URL=https://app.example.com

# ── Email (Resend) — docs/EMAIL.md ───────────────────────────────────────────────────────────
# [PROD] Resend API key (Resend → API Keys). Server only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# [PROD] The sender. Required — there is no built-in default.
#   Development / before you own a domain:  onboarding@resend.dev
#       (Resend's testing sender: it delivers ONLY to the e-mail address of your own Resend account, so invitations to other people will not arrive.)
#   After you verify a domain in Resend:     no-reply@your-domain.com   or   Kayan <no-reply@your-domain.com>
# Changing this value in Vercel (+ redeploy) is the ONLY change needed to switch senders.
RESEND_FROM_EMAIL=onboarding@resend.dev
# [OPTIONAL] Where replies go, and the support address shown in e-mail footers.
RESEND_REPLY_TO=
KAYAN_SUPPORT_EMAIL=

# ── Subscription reminders (Vercel Cron → /api/cron/subscription-reminders) ──────────────────
# [PROD] Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it automatically as "Authorization: Bearer <value>".
# Without it the cron route refuses every request.
CRON_SECRET=

# ── Payments (XPay) — docs/BILLING.md ────────────────────────────────────────────────────────
# [PROD] sk_live_… in production. A sk_test_… key is REFUSED in production (Vercel previews and local development may use it).
XPAY_SECRET_KEY=sk_test_xxxxxxxx
# [PROD] Signing secret of the webhook you create in XPay for  https://YOUR-DOMAIN/api/webhooks/xpay
XPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
# [PROD] Must be exactly "true" before real checkouts open — set it only after the REAL prices in src/config/pricing.config.ts are confirmed.
BILLING_PRICES_CONFIRMED=false
# [OPTIONAL] Defaults to https://api.xpay.app. In production only an xpay.app https host is accepted.
XPAY_API_BASE_URL=

# ── Platform administrator (Super Admin) ─────────────────────────────────────────────────────
# [PROD] Comma-separated Supabase user IDs allowed into /admin (preferred — IDs cannot be spoofed).
SUPER_ADMIN_USER_IDS=
# [OPTIONAL] Comma-separated e-mail addresses, honoured only for CONFIRMED accounts. Prefer the IDs above.
SUPER_ADMIN_EMAILS=

# ── Error monitoring (Sentry) — optional, off without a DSN ──────────────────────────────────
# Server and browser reports (scrubbed: no cookies, headers, query strings, bodies or e-mail addresses).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
